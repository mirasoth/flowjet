# syntax=docker/dockerfile:1
# FlowJet server image on top of the prebuilt base (deps venv + chromium).
# Only flowjet itself is installed here — a source-only change rebuilds in
# seconds instead of re-resolving the whole lockfile.
#
# Build:
#   docker build -f Dockerfile.prebuilt \
#     --build-arg FLOWJET_BASE=registry.cn-hangzhou.aliyuncs.com/lacogito/flowjet-base:latest \
#     -t flowjet-server:latest .
#
# If the base venv drifted from this tree's uv.lock, `uv sync --frozen` below
# fails loudly at build time (no silent drift into a broken image). To rebuild
# the base, run .github/workflows/docker-base.yml or:
#   docker build -f Dockerfile.base -t <base-ref> .

ARG FLOWJET_BASE=registry.cn-hangzhou.aliyuncs.com/lacogito/flowjet-base:latest

# Reference skills baked into the flowjet user's ~/.agents/skills — keep in
# sync with the standalone Dockerfile.
ARG PYTHON_BASE=registry.cn-hangzhou.aliyuncs.com/lacogito/python:3.12-bookworm
ARG PLATONIC_CODING_REPO=https://github.com/caesar0301/platonic-coding.git
ARG PLATONIC_CODING_REF=main
ARG OH_MY_RESEARCH_REPO=https://github.com/caesar0301/oh-my-research.git
ARG OH_MY_RESEARCH_REF=main

# Stage: fetch reference skills (shallow clones, no .git shipped)
FROM ${PYTHON_BASE} AS skills

ARG PLATONIC_CODING_REPO
ARG PLATONIC_CODING_REF
ARG OH_MY_RESEARCH_REPO
ARG OH_MY_RESEARCH_REF

RUN sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${PLATONIC_CODING_REF}" "${PLATONIC_CODING_REPO}" /tmp/platonic-coding \
    && git clone --depth 1 --branch "${OH_MY_RESEARCH_REF}" "${OH_MY_RESEARCH_REPO}" /tmp/oh-my-research

FROM ${FLOWJET_BASE} AS runtime

LABEL org.opencontainers.image.title="FlowJet Server" \
    org.opencontainers.image.description="OpenAI-compatible HTTP service over soothe-nano" \
    org.opencontainers.image.source="https://github.com/mirasoth/flowjet-server"

ENV FLOWJET_HOME=/flowjet \
    FLOWJET_HOST=0.0.0.0 \
    FLOWJET_PORT=8618

WORKDIR /app

COPY pyproject.toml uv.lock README.md /app/
COPY src /app/src
# The base venv already satisfies the lock; this only builds + installs the
# local flowjet wheel. --frozen keeps everything pinned to uv.lock.
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_PROJECT_ENVIRONMENT=/app/.venv uv sync --no-dev --frozen --no-editable --extra server

# Default nano config, read by the service from $FLOWJET_HOME/config/nano.yml.
COPY config/nano.yml /flowjet/config/nano.yml

# Bake reference skills into the flowjet user's ~/.agents/skills (the flowjet
# user's $HOME, scanned by soothe-nano's SkillRoots).
COPY --from=skills --chown=flowjet:flowjet \
    /tmp/platonic-coding/skills/platonic-coding /home/flowjet/.agents/skills/platonic-coding
COPY --from=skills --chown=flowjet:flowjet \
    /tmp/oh-my-research/skills/oh-my-research /home/flowjet/.agents/skills/oh-my-research

USER flowjet
WORKDIR /flowjet

EXPOSE 8618/tcp

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8618/health', timeout=3)" || exit 1

CMD ["flowjet-server"]
