# FlowJet Server Deployment Environment Variables
# Copy this file to .env and configure before deployment.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=${DASHSCOPE_API_KEY}

# Optional: require Bearer auth on /v1 endpoints (leave blank for no auth)
FLOWJET_API_KEY=

# Optional: override published port / bind IP (defaults: 8618 / 127.0.0.1)
# FLOWJET_PORT_PUBLISHED=8618
# FLOWJET_BIND_IP=127.0.0.1

# Optional: how an ask_user pause reaches clients (default: markdown).
#   markdown — Markdown agent message (historical wire)
#   json     — structured envelope (ACP: embedded JSON resource block;
#              OpenAI surface: response.flowjet.clarification SSE event)
#   both     — Markdown + structured payload
# FLOWJET_CLARIFICATION_FORMAT=markdown
